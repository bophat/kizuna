# =============================================================================
# KIZUNA Backend (Django) — Render.com
# =============================================================================
# Render Dashboard → Web Service → Environment → Add từng biến
# Build Command:  ./build.sh   (hoặc lệnh trong render.yaml)
# Start Command:   gunicorn core.wsgi:application --bind 0.0.0.0:$PORT
# =============================================================================

# --- Bắt buộc ---
DJANGO_SECRET_KEY=change-me-to-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=kizuna-api.onrender.com,localhost,127.0.0.1

# Postgres (Render tự inject khi link database)
DATABASE_URL=

# CORS: URL Vercel (không dấu / cuối), phân tách bằng dấu phẩy
# Ví dụ production:
# CORS_ALLOWED_ORIGINS=https://kizuna-admin.vercel.app,https://kizuna-website.vercel.app
CORS_ALLOWED_ORIGINS=https://your-website.vercel.app,https://your-admin.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-website.vercel.app,https://your-admin.vercel.app,https://kizuna-api.onrender.com

# --- Tuỳ chọn ---
MEDIA_ROOT=/var/data/media

# Cloud Run: set this to use a private Cloud Storage bucket instead of local disk.
# Authentication comes from the Cloud Run service account; do not use a JSON key.
GCS_BUCKET_NAME=
EXCHANGE_RATE_CACHE_SECONDS=3600
SECURE_SSL_REDIRECT=True

# Email verification (use credentials from your SMTP provider)
WEBSITE_URL=https://your-website.vercel.app
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=KIZUNA <no-reply@your-domain.com>
EMAIL_VERIFICATION_TIMEOUT=86400

# --- AI / Chatbot bridge ---
CHATBOT_INTERNAL_TOKEN=change-me-shared-secret-with-flask
CHATBOT_SERVICE_URL=http://127.0.0.1:8080
CHATBOT_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: separate key for encrypting settings secrets at rest (defaults to DJANGO_SECRET_KEY)
SETTINGS_ENCRYPTION_KEY=

# --- Affiliate / collaborator commissions ---
AFFILIATE_RETURN_WINDOW_DAYS=14
AFFILIATE_MIN_PAYOUT_USD=20.00

# --- Amazon Japan / Qoo10 source import ---
# Production must keep fake providers disabled. Enable only for local development/tests.
SOURCE_IMPORT_USE_FAKE_PROVIDERS=False
# If provider credentials are absent, read public product metadata without login/CAPTCHA bypass.
SOURCE_IMPORT_PUBLIC_PAGE_FALLBACK_ENABLED=true
SOURCE_IMPORT_PUBLIC_PAGE_MAX_BYTES=4194304
SOURCE_IMPORT_PUBLIC_PAGE_TIMEOUT_SECONDS=15
SOURCE_IMPORT_PUBLIC_PAGE_MAX_REDIRECTS=3
SOURCE_IMPORT_PUBLIC_PAGE_CACHE_SECONDS=900
USD_VND_RATE=25000
ALLOW_AUTO_CREATE_CATEGORY=false
SOURCE_IMPORT_MAX_BATCH=50
SOURCE_IMPORT_JPY_BUFFER=1000
SOURCE_IMPORT_JPY_TO_VND_RATE=200
SOURCE_IMPORT_MARKUP_RATE=0.15
SOURCE_IMPORT_LIGHT_SHIPPING_VND=20000
SOURCE_IMPORT_HEAVY_SHIPPING_PER_KG_VND=180000
SOURCE_IMPORT_HEAVY_WEIGHT_THRESHOLD_KG=0.5
AUTO_UPDATE_MAX_INCREASE_PERCENT=5
REVIEW_PRICE_INCREASE_PERCENT=15
SOURCE_IMPORT_ALLOWED_IMAGE_HOSTS=
# Enable only when you have permission to store and redistribute provider images.
SOURCE_IMPORT_IMAGE_DOWNLOAD_ENABLED=false
SOURCE_IMPORT_IMAGE_MAX_BYTES=10485760
SOURCE_IMPORT_IMAGE_MAX_PIXELS=40000000
SOURCE_IMPORT_IMAGE_TIMEOUT_SECONDS=10
SOURCE_IMPORT_IMAGE_MAX_REDIRECTS=3
SOURCE_PROVIDER_TIMEOUT_SECONDS=10
SOURCE_PROVIDER_MAX_ATTEMPTS=3

# Amazon Creators API (PA-API keys are no longer supported).
# Obtain these in Amazon Associates > Creators API.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.3
AMAZON_JP_PARTNER_TAG=

# Qoo10 QAPI seller certification key.
QOO10_CERTIFICATION_KEY=

# Pre-create this active staff user before using MCP write tools.
MCP_SYSTEM_USERNAME=mcp_system_user

# --- Dev local (không set DATABASE_URL → dùng SQLite) ---
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=*
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
