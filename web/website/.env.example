# =============================================================================
# KIZUNA Website — biến môi trường cho Vercel (và dev local)
# =============================================================================
# 1. Copy file này:  cp .env.example .env.local
# 2. Điền giá trị thật vào .env.local (không commit .env.local)
# 3. Trên Vercel: Project Settings → Environment Variables → thêm từng biến VITE_*
# 4. Vercel: Root Directory = web/website  |  Framework = Vite
# =============================================================================

# --- Bắt buộc (production) ---
# Django trên Render (có /api ở cuối)
VITE_API_BASE_URL=https://kizuna-api.onrender.com/api

# URL gốc backend — ảnh /media (KHÔNG có /api)
VITE_MEDIA_BASE_URL=https://kizuna-api.onrender.com

# URL website sau deploy (dùng để build canonical/og:url cho SEO — điền khi có domain chính)
VITE_APP_URL=https://your-website.vercel.app

# Google Analytics 4 Measurement ID (Admin → Data Streams → Web, dạng G-XXXXXXXXXX)
# Để trống = chưa gắn, site không gửi request nào tới Google. Điền vào là tự chạy.
VITE_GA_MEASUREMENT_ID=

# --- Concierge / Live chat (tuỳ chọn) ---
# Service chat (port 8080 khi dev). Chỉ dùng cho SSE admin reply trên trang Concierge
VITE_CHAT_API_BASE_URL=https://your-chatbot.example.com/api

# Gemini API key: cấu hình trên Django backend (GEMINI_API_KEY), không cần trên frontend

# --- Dev local (mặc định nếu không set) ---
# Dùng "localhost" (không phải 127.0.0.1) để cùng site với trang web đang mở.
# Trình duyệt coi localhost và 127.0.0.1 là hai site khác nhau, nên cookie đăng
# nhập (SameSite=Lax) sẽ không được gửi kèm ở các request sau — triệu chứng là
# "vừa đăng nhập xong mà thêm giỏ hàng lại bắt đăng nhập lại".
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_MEDIA_BASE_URL=http://localhost:8000
# VITE_CHAT_API_BASE_URL=http://localhost:8080/api
