{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kizuna-website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web/website"
      ],
      "port": 3000
    },
    {
      "name": "kizuna-website-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web/website",
        "--",
        "--port=3100"
      ],
      "port": 3100
    },
    {
      "name": "kizuna-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web/admin",
        "--",
        "--port=3101"
      ],
      "port": 3101
    }
  ]
}